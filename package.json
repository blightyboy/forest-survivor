{
  "name": "forest-survivor",
  "productName": "Forest Survivor",
  "version": "0.2.1-alpha-build",
  "description": "Chop, hunt, and fortify your forest camp.",
  "main": "electron/main.js",
  "author": "Forest Survivor",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"cross-env VITE_DEV_SERVER_URL=http://localhost:5173/ electron .\"",
    "build:web": "vite build",
    "start": "npm run build:web && cross-env FOREST_VITE=0 electron .",
    "icon": "node electron/make-icon.js",
    "build": "npm run build:web && node electron/make-icon.js && node electron/preserve-save.js backup && node electron/run-builder.js --win && node electron/preserve-save.js restore",
    "build:dir": "npm run build:web && node electron/make-icon.js && node electron/preserve-save.js backup && node electron/run-builder.js --win --dir && node electron/preserve-save.js restore",
    "build:portable": "npm run build:web && node electron/make-icon.js && node electron/preserve-save.js backup && node electron/run-builder.js --win portable && node electron/preserve-save.js restore",
    "release": "npm run build:web && node electron/make-icon.js && node electron/run-builder.js --win --publish always",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.forestsurvivor.game",
    "productName": "Forest Survivor",
    "copyright": "Copyright © Forest Survivor",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "icon": "build/icon.ico",
    "afterPack": "./electron/after-pack.js",
    "files": [
      "dist-web/**/*",
      "electron/**/*",
      "icon.png",
      "package.json"
    ],
    "extraFiles": [],
    "win": {
      "icon": "build/icon.ico",
      "sign": false,
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "ForestSurvivor-Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Forest Survivor",
      "artifactName": "ForestSurvivor-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "blightyboy",
        "repo": "forest-survivor",
        "releaseType": "prerelease"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^6.0.0",
    "rcedit": "^5.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "phaser": "^3.87.0"
  }
}

