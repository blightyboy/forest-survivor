{
  "name": "forest-survivor",
  "productName": "Forest Survivor",
  "version": "0.1.23-alpha-build",
  "description": "Chop, hunt, and fortify your forest camp.",
  "main": "electron/main.js",
  "author": "Forest Survivor",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "icon": "node electron/make-icon.js",
    "build": "node electron/make-icon.js && node electron/preserve-save.js backup && node electron/run-builder.js --win && node electron/preserve-save.js restore",
    "build:dir": "node electron/make-icon.js && node electron/preserve-save.js backup && node electron/run-builder.js --win --dir && node electron/preserve-save.js restore",
    "build:portable": "node electron/make-icon.js && node electron/preserve-save.js backup && node electron/run-builder.js --win portable && node electron/preserve-save.js restore",
    "release": "node electron/make-icon.js && node electron/run-builder.js --win --publish always"
  },
  "build": {
    "appId": "com.forestsurvivor.game",
    "productName": "Forest Survivor",
    "copyright": "Copyright © Forest Survivor",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "icon": "build/icon.ico",
    "afterPack": "./electron/after-pack.js",
    "files": [
      "index.html",
      "style.css",
      "js/**/*",
      "electron/**/*",
      "icon.png",
      "package.json"
    ],
    "extraFiles": [],
    "win": {
      "icon": "build/icon.ico",
      "sign": false,
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "ForestSurvivor-Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Forest Survivor",
      "artifactName": "ForestSurvivor-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "blightyboy",
        "repo": "forest-survivor",
        "releaseType": "prerelease"
      }
    ]
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "rcedit": "^5.0.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
